# Zaszyfrowana partycja danych: klucz zapieczętowany w TPM pod politykę PCR.
# tpm2-device wskazuje jawnie TPM z łańcuchem measured boot (tpm_tis),
# a nie fTPM z OP-TEE. nofail: bez odblokowania system i tak startuje.
# Dodanie sciezki do pliku pcrlock.json na partycji /persist
data /dev/disk/by-partlabel/data - tpm2-device=/dev/tpmrm0,tpm2-pcrlock=/persist/pcrlock/pcrlock.json,nofail
